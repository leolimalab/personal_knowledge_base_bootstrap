{"edges": [{"fromNode": "a1b2c3d4e5f60001", "fromSide": "right", "id": "c1d2e3f4a5b60001", "label": "primeira referência", "toNode": "a1b2c3d4e5f60002", "toSide": "left"}, {"fromNode": "a1b2c3d4e5f60002", "fromSide": "right", "id": "c1d2e3f4a5b60002", "label": "gera", "toNode": "b1c2d3e4f5a60001", "toSide": "left"}, {"fromNode": "a1b2c3d4e5f60002", "fromSide": "right", "id": "c1d2e3f4a5b60003", "label": "gera", "toNode": "b1c2d3e4f5a60002", "toSide": "left"}, {"fromNode": "a1b2c3d4e5f60002", "fromSide": "right", "id": "c1d2e3f4a5b60004", "label": "gera", "toNode": "b1c2d3e4f5a60003", "toSide": "left"}, {"fromNode": "a1b2c3d4e5f60002", "fromSide": "bottom", "id": "c1d2e3f4a5b60005", "label": "fonte", "toNode": "a1b2c3d4e5f60003", "toSide": "top"}], "nodes": [{"file": "01 Projects/Mestrado/Mestrado.md", "height": 200, "id": "a1b2c3d4e5f60001", "type": "file", "width": 300, "x": 0, "y": 150}, {"file": "03 Resources/2026-10-01 - AMIE prospective feasibility study.md", "height": 250, "id": "a1b2c3d4e5f60002", "type": "file", "width": 350, "x": 450, "y": 150}, {"height": 100, "id": "a1b2c3d4e5f60003", "type": "link", "url": "https://arxiv.org/abs/2603.08448", "width": 350, "x": 450, "y": 450}, {"height": 150, "id": "b1c2d3e4f5a60001", "text": "## Supervisão real-time\n\nHumano monitora tudo como gold standard p/ LLM falando c/ paciente.", "type": "text", "width": 300, "x": 950, "y": 0}, {"height": 150, "id": "b1c2d3e4f5a60002", "text": "## Sem EHR limita\n\nTexto puro trava diagnóstico. Multimodalidade = próximo passo.", "type": "text", "width": 300, "x": 950, "y": 200}, {"height": 150, "id": "b1c2d3e4f5a60003", "text": "## Dx ≠ manejo\n\nIA empata diagnóstico, perde praticidade/custo. Saber o quê ≠ conduzir.", "type": "text", "width": 300, "x": 950, "y": 400}]}